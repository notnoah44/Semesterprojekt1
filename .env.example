EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
EXPO_PUBLIC_PASSWORD_RESET_URL=

# Purchases stay disabled unless explicitly configured. Requires a development build.
# test_store uses RevenueCat's test_ key; store uses Apple/Google (sandbox testers required).
EXPO_PUBLIC_BILLING_MODE=disabled
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
